# Copy this file to .env for local development. Never commit the real .env.

# SQLite for local dev. Swap this one line for a postgresql+psycopg:// URL
# later to move to Postgres — nothing else in the backend needs to change.
JOURNAL_DATABASE_URL=sqlite:///./journal_dev.db

# Must stay false on plain http://localhost — browsers drop Secure cookies
# on non-HTTPS origins. Set to true only once the backend is served over
# HTTPS in a real deployment.
JOURNAL_COOKIE_SECURE=false

# JSON array of allowed frontend origins for CORS (credentials=true requires
# an explicit list, not a wildcard).
JOURNAL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Fernet key (32 urlsafe-base64-encoded bytes) used to encrypt broker
# credentials at rest. Optional for local dev — if left unset, the backend
# auto-generates one on first run and stores it in a gitignored local file
# (backend/.broker_encryption_key). Set this explicitly for anything beyond
# local dev, generated per-environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never reuse the same key across dev/staging/production, and never commit
# a real value here.
JOURNAL_BROKER_ENCRYPTION_KEY=

# Razorpay — TEST MODE credentials only, from your Razorpay dashboard's Test
# Mode API Keys screen. Never put live keys here or anywhere in source
# control. The webhook secret is whatever you set when creating a test
# webhook (Razorpay Dashboard > Webhooks) pointed at /api/billing/webhook.
JOURNAL_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
JOURNAL_RAZORPAY_KEY_SECRET=your_test_key_secret
JOURNAL_RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
